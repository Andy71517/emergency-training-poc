# Copy this file to arc/.env and fill in the values assigned to your ARC project.
# arc/.env is ignored by Git. Do not commit credentials, tokens, SSH keys, or
# raw job outputs here.

# Slurm allocation/account shown by `sacctmgr show assoc`.
ARC_ACCOUNT=

# Approved ARC project-storage root, for example /projects/your-allocation.
ARC_PROJECT_STORAGE_ROOT=

# Project-specific workspace under the approved storage root.
ARC_PROJECT_WORKSPACE=

# Partitions confirmed for this allocation. Do not guess these names.
ARC_CPU_PARTITION=
ARC_GPU_PARTITION=

# QoS values confirmed for the configured partitions. For TinkerCliffs A100
# base work, the current value is tc_a100_normal_base.
ARC_CPU_QOS=
ARC_GPU_QOS=

# Record a selected model/container only after Phase 0 approval.
ARC_ASSET_MODEL=
ARC_CONTAINER_IMAGE=

# TRELLIS.2 runtime inputs. Keep the source revision immutable; update it only
# through an intentional reviewed change. The build records the resulting SIF
# SHA-256 because an upstream image tag is not itself an immutable digest.
ARC_TRELLIS2_REPOSITORY=https://github.com/microsoft/TRELLIS.2.git
ARC_TRELLIS2_REVISION=75fbf0183001ed9876c8dbb35de6b68552ee08bd
ARC_TRELLIS2_CONTAINER_IMAGE=docker://pytorch/pytorch:2.6.0-cuda12.4-cudnn9-devel
