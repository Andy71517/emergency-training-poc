{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/emergency-training-poc/events/scenario_state.schema.json",
  "title": "ScenarioState",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "scenario_id",
    "event_id",
    "timestamp",
    "sequence_number",
    "state",
    "is_terminal",
    "next_expected_actions"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "session_id": { "type": "string", "minLength": 1 },
    "scenario_id": { "type": "string", "minLength": 1 },
    "event_id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "sequence_number": { "type": "integer", "minimum": 0 },
    "state": {
      "type": "object",
      "required": ["phase", "scene_assessed", "ppe_confirmed", "backup_requested", "occupant_removed", "scenario_outcome"],
      "additionalProperties": true,
      "properties": {
        "phase": { "type": "string" },
        "scene_assessed": { "type": "boolean" },
        "ppe_confirmed": { "type": "boolean" },
        "backup_requested": { "type": "boolean" },
        "path_blocked": { "type": "boolean" },
        "door_open": { "type": "boolean" },
        "occupant_removed": { "type": "boolean" },
        "scenario_outcome": { "enum": ["in_progress", "completed", "stopped"] },
        "environment": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "objects": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "wooden_chair_poc": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "object_type": { "const": "wooden_chair" },
                    "label": { "type": "string" },
                    "location": { "type": "string" },
                    "blocks_path": { "type": "boolean" },
                    "moved": { "type": "boolean" },
                    "physics_enabled": { "type": "boolean" },
                    "physics_note": { "type": "string" }
                  }
                },
                "entry_door_poc": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "object_type": { "const": "door" },
                    "label": { "type": "string" },
                    "location": { "type": "string" },
                    "blocks_path": { "type": "boolean" },
                    "open_state": { "enum": ["open", "closed"] },
                    "locked": { "type": "boolean" },
                    "door_type": { "type": "string" },
                    "hinge_side": { "type": "string" },
                    "swing_direction": { "type": "string" },
                    "collision_enabled": { "type": "boolean" },
                    "collision_shape": { "type": "string" },
                    "mass_kg_estimate": { "type": "number" },
                    "force_preview": { "type": "object" },
                    "physics_note": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "is_terminal": { "type": "boolean" },
    "next_expected_actions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
