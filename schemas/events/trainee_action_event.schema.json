{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/emergency-training-poc/events/trainee_action_event.schema.json",
  "title": "TraineeActionEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "scenario_id",
    "event_id",
    "timestamp",
    "actor_id",
    "action_type",
    "payload",
    "sequence_number"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "session_id": { "$ref": "#/$defs/safe_identifier" },
    "scenario_id": { "$ref": "#/$defs/scenario_identifier" },
    "event_id": { "$ref": "#/$defs/safe_identifier" },
    "timestamp": { "type": "string", "format": "date-time" },
    "actor_id": { "$ref": "#/$defs/safe_identifier" },
    "action_type": { "$ref": "#/$defs/action_type" },
    "payload": { "$ref": "#/$defs/safe_payload" },
    "sequence_number": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "safe_identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "scenario_identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9_]+$"
    },
    "action_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "safe_payload": {
      "type": "object",
      "maxProperties": 20
    }
  }
}
