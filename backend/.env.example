# Private local configuration; copy to backend/.env. Never commit the real key.
ARC_LLM_API_KEY=
ARC_LLM_MODEL=gpt-oss-120b


# Optional local Blender worker. Use full paths; forward slashes work on Windows.
BLENDER_EXECUTABLE=C:/Program Files/Blender Foundation/Blender 5.1/blender.exe
CHAIR_BLEND=C:/your-assets/chair-collision-complete.blend

# Existing verified SSH alias (or PID@tinkercliffs2.arc.vt.edu). No passwords/keys here.
ARC_SSH_TARGET=
ARC_REMOTE_REPO=/home/YOUR_PID/emergency-training-poc
